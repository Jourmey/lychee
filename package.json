{
  "name": "lychee",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build-course": "node scripts/build-course.mjs",
    "align-transcript": "node scripts/align-transcript.mjs",
    "slice-audio": "node scripts/slice-audio.mjs",
    "doodle-ink": "node scripts/extract-doodle-ink.mjs",
    "slice-keep": "node scripts/slice-keep.mjs",
    "fetch-imgs": "node scripts/fetch-imgs.mjs",
    "tts": "node scripts/tts.mjs",
    "data": "pnpm build-course && pnpm align-transcript && pnpm slice-audio",
    "data2": "DATASET=data2 node scripts/fetch-imgs.mjs && node scripts/data2-timeline.mjs && node scripts/data2-build-pages.mjs && DATASET=data2 node scripts/build-course.mjs && DATASET=data2 node scripts/slice-audio.mjs --write",
    "data3": "DATASET=data3 node scripts/fetch-imgs.mjs && DATASET=data3 node scripts/tts-pages.mjs && DATASET=data3 node scripts/build-course.mjs",
    "data4": "DATASET=data4 node scripts/build-course.mjs"
  },
  "dependencies": {
    "@openmaic/dsl": "workspace:*",
    "@openmaic/renderer": "workspace:*",
    "clsx": "2.1.1",
    "echarts": "6.1.0",
    "katex": "0.16.47",
    "lucide-react": "0.562.0",
    "motion": "12.43.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "^8.3.1",
    "shiki": "4.4.3",
    "tailwind-merge": "3.6.0",
    "tinycolor2": "1.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "4.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  }
}
